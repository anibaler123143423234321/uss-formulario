---
// Header.astro - Totalmente blanco e institucional USS
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200/80 bg-white/95 backdrop-blur-md shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20 gap-4">
      
      <!-- Brand & Título del Formulario con Logo Oficial -->
      <div class="flex items-center gap-3 sm:gap-4 min-w-0">
        <!-- Contenedor para el logo blanco con fondo azul marino institucional USS -->
        <div class="flex-shrink-0 flex items-center justify-center px-3 py-1.5 rounded-xl bg-gradient-to-r from-blue-950 via-blue-900 to-blue-800 border border-blue-950 shadow-sm shadow-blue-950/20">
          <img
            src="/Logo%20CInf%20USS_Blanco.png"
            alt="Logo USS Centro de Informática"
            class="h-7 sm:h-9 w-auto object-contain"
          />
        </div>

        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <span class="text-xs sm:text-sm font-bold uppercase tracking-wider text-amber-700 bg-amber-50 px-2.5 py-0.5 rounded border border-amber-200">
              Formulario de Capacitación
            </span>
            <span class="hidden md:inline-flex text-xs text-slate-500 font-medium">
              SGC • Modelo SUNEDU • ISO Core
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
