---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FormWizardReact from '../components/FormWizardReact';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />

  <main class="flex-1 max-w-4xl w-full mx-auto px-3 sm:px-4 py-2 sm:py-3">
    <FormWizardReact client:load />
  </main>

  <Footer />
</Layout>
