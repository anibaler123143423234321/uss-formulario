---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FormWizardReact from '../components/FormWizardReact';
import EncuestaDocenteReact from '../components/EncuestaDocenteReact';
import Footer from '../components/Footer.astro';

const isEncuestaDocente = Astro.url.searchParams.get('tipo') === 'encuesta' || Astro.url.searchParams.has('encuesta');
const encuestaId = Astro.url.searchParams.get('encuesta') || Astro.url.searchParams.get('id');
---

<Layout>
  {isEncuestaDocente ? (
    <div class="w-full bg-[#ede7f6] min-h-screen py-6 px-3.5">
      <header class="w-full bg-white border-b border-slate-200/80 py-3 shadow-2xs mb-6 -mt-6 -mx-3.5 px-4 flex items-center justify-center">
        <img
          src="/Logo_CInf_USS_Negro.png"
          alt="USS Centro de Informática"
          class="h-10 sm:h-12 w-auto object-contain"
        />
      </header>
      <EncuestaDocenteReact client:load eventoId={encuestaId ? Number(encuestaId) : undefined} />
    </div>
  ) : (
    <>
      <Header />
      <main class="flex-1 max-w-4xl w-full mx-auto px-3 sm:px-4 py-2 sm:py-3">
        <FormWizardReact client:load />
      </main>
      <Footer />
    </>
  )}
</Layout>
