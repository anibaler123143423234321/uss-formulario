---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Formulario de Capacitación | Universidad Señor de Sipán",
  description = "Formulario oficial de evaluación de capacitación USS, estándares ISO Core y modelo de supervisión SUNEDU."
} = Astro.props;
---

<!doctype html>
<html lang="es" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎓</text></svg>" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-slate-900 m-0 p-0 antialiased min-h-screen flex flex-col selection:bg-blue-600 selection:text-white">
    <slot />
  </body>
</html>
